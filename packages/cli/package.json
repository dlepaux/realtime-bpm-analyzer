{
  "name": "realtime-bpm-analyzer-cli",
  "version": "0.0.0",
  "description": "Detect the BPM of audio files from the command line: npx realtime-bpm-analyzer-cli song.mp3. MP3, WAV, FLAC, OGG Vorbis and Opus decode in pure JS/WASM; M4A goes through ffmpeg.",
  "author": {
    "name": "David Lepaux",
    "email": "d.lepaux@gmail.com",
    "url": "https://david.lepaux.com"
  },
  "keywords": [
    "bpm",
    "tempo",
    "beat-detection",
    "tempo-detection",
    "bpm-detection",
    "audio",
    "audio-analysis",
    "music-analysis",
    "mp3",
    "flac",
    "cli",
    "dj"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/api.d.ts",
      "import": "./dist/api.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "realtime-bpm-analyzer": "dist/cli.mjs",
    "rba": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/api.mjs",
    "dist/types/api.d.ts",
    "readme.md",
    "license.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --banner:js='#!/usr/bin/env node' --outfile=dist/cli.mjs && esbuild src/api.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/api.mjs && tsc --noEmit && tsc -p tsconfig.api.json",
    "prepack": "cp ../../license.md .",
    "postpack": "rm -f license.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "homepage": "https://www.realtime-bpm-analyzer.com/guide/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlepaux/realtime-bpm-analyzer",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@audio/decode-flac": "^1.3.5",
    "@audio/decode-mp3": "^1.3.1",
    "@audio/decode-opus": "^1.3.3",
    "@audio/decode-vorbis": "^1.3.4",
    "@audio/decode-wav": "^1.5.1",
    "realtime-bpm-analyzer": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
