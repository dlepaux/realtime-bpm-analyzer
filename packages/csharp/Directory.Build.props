<Project>
  <!-- Shared by the library and its tests: strict, reproducible builds. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned, not latest: an SDK patch that adds a rule must not turn the build red on its own. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Pinned restores: CI restores in locked mode, so a dependency can't change under a build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Source paths in the PDB are made relative on CI, so the same commit builds the same bytes anywhere. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
