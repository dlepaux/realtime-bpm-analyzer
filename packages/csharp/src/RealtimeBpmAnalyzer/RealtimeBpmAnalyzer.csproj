<Project Sdk="Microsoft.NET.Sdk">
  <!--
    netstandard2.0 is what Unity's ".NET Standard" API compatibility level and Godot's C# projects both accept, and it
    is enough: nothing here needs 2.1. No PackageReference and no unsafe code, so the package brings nothing but the
    base class library (ApiTests pins both).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RealtimeBpmAnalyzer</RootNamespace>
    <AssemblyName>RealtimeBpmAnalyzer</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>RealtimeBpmAnalyzer</PackageId>
    <Version>6.2.0</Version>
    <Authors>David Lepaux</Authors>
    <Description>Offline BPM analysis of PCM samples, in pure managed C#: the .NET port of the realtime-bpm-analyzer JS library, with the same readings, which shared conformance vectors check. For Unity, Godot C# and .NET apps.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.realtime-bpm-analyzer.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dlepaux/realtime-bpm-analyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bpm;tempo;beat-detection;audio;music;unity;godot</PackageTags>
    <PackageReleaseNotes>https://github.com/dlepaux/realtime-bpm-analyzer/blob/main/packages/csharp/changelog.md</PackageReleaseNotes>
  </PropertyGroup>

  <!--
    Debugging into the package from nuget.org (RBA-272). The SDK's built-in Source Link (.NET 8 and later, no
    PackageReference) writes the GitHub commit and URLs into the PDB, and PublishRepositoryUrl puts the commit in the
    nuspec. The PDB is embedded in the DLL rather than shipped as a .snupkg, so the push is one file and a debugger
    finds the symbols with no symbol server. Deterministic and ContinuousIntegrationBuild are in Directory.Build.props.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../readme.md" Pack="true" PackagePath="/"/>
    <InternalsVisibleTo Include="RealtimeBpmAnalyzer.Tests"/>
  </ItemGroup>
</Project>
