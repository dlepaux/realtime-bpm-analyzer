<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET 10, the current LTS (8 left support on 2026-11-10). xUnit in test scope only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names read as sentences (CA1707), and literal arrays in assertions run once (CA1861). -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RealtimeBpmAnalyzer/RealtimeBpmAnalyzer.csproj" />
  </ItemGroup>

  <!-- Where the shared vectors and the JS sources sit in the repo, baked in so the tests find them from bin/. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ConformanceDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../conformance'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JsSourceDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../realtime-bpm-analyzer/src'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
