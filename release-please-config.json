{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/realtime-bpm-analyzer": {
      "package-name": "realtime-bpm-analyzer",
      "component": "realtime-bpm-analyzer",
      "include-component-in-tag": false,
      "changelog-path": "changelog.md"
    },
    "packages/cli": {
      "package-name": "realtime-bpm-analyzer-cli",
      "component": "cli",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "initial-version": "0.1.0"
    },
    "packages/mcp": {
      "package-name": "realtime-bpm-analyzer-mcp",
      "component": "mcp",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "initial-version": "0.1.0"
    },
    "packages/jvm": {
      "release-type": "maven",
      "component": "jvm",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "skip-snapshot": true,
      "extra-files": ["readme.md", "/docs/guide/java.md", "/docs/index.md", "/readme.md"],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    },
    "packages/python": {
      "release-type": "python",
      "package-name": "realtime-bpm-analyzer",
      "component": "python",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    },
    "packages/csharp": {
      "release-type": "simple",
      "component": "csharp",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "extra-files": [
        { "type": "xml", "path": "src/RealtimeBpmAnalyzer/RealtimeBpmAnalyzer.csproj", "xpath": "//Project/PropertyGroup/Version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    },
    "packages/swift": {
      "release-type": "simple",
      "component": "swift",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    }
  }
}
