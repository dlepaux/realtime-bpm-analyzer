{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/realtime-bpm-analyzer": {
      "package-name": "realtime-bpm-analyzer",
      "component": "realtime-bpm-analyzer",
      "include-component-in-tag": false,
      "release-as": "6.1.0",
      "changelog-path": "changelog.md"
    },
    "packages/cli": {
      "package-name": "realtime-bpm-analyzer-cli",
      "component": "cli",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "initial-version": "0.1.0"
    },
    "packages/mcp": {
      "package-name": "realtime-bpm-analyzer-mcp",
      "component": "mcp",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "initial-version": "0.1.0"
    }
  }
}
