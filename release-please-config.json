{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "separate-pull-requests": true,
  "packages": {
    "packages/realtime-bpm-analyzer": {
      "package-name": "realtime-bpm-analyzer",
      "component": "realtime-bpm-analyzer",
      "include-component-in-tag": false,
      "changelog-path": "changelog.md",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/realtime-bpm-analyzer'].version"
        }
      ]
    },
    "packages/cli": {
      "package-name": "realtime-bpm-analyzer-cli",
      "component": "cli",
      "include-component-in-tag": true,
      "changelog-path": "changelog.md",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/cli'].version"
        }
      ]
    }
  }
}
